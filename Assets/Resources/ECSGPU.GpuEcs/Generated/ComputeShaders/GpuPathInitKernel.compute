
#pragma kernel CSInitializePathGrid

struct GpuGridCoordComponent
{
    int2 Value;
};

struct GpuPathStateComponent
{
    int Distance;
    int BestDirection;
    uint Walkable;
    uint Padding;
};

StructuredBuffer<GpuGridCoordComponent> _coords;
RWStructuredBuffer<GpuPathStateComponent> _state;

uint _entityCount;
int _targetX;
int _targetY;
int _blockedDistance;

[numthreads(64, 1, 1)]
void CSInitializePathGrid(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _entityCount)
    return;
    int2 coord = _coords[idx].Value;
    GpuPathStateComponent cell = _state[idx];
    cell.BestDirection = -1;
    if (cell.Walkable == 0u)
    {
        cell.Distance = _blockedDistance;
        _state[idx] = cell;
        return;
    }
    if (coord.x == _targetX && coord.y == _targetY)
    {
        cell.Distance = 0;
        cell.BestDirection = 4;
    }
    else
    {
        cell.Distance = _blockedDistance;
    }
    _state[idx] = cell;
}


